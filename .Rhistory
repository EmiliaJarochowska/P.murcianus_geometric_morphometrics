)
# Plot with ggplot2
ggplot(pca_data, aes(x = PC1, y = PC2, color = Country, shape = Country)) +
geom_point(size = 2) +
scale_shape_manual(values = symbols, labels = country_full_names) +  # Update with full names
scale_color_manual(values = c(
