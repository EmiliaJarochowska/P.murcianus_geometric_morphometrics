```{r fig-dispersion_chirality, fig.cap ="Dispersion of elements by their chirality"}
bd_chirality <- betadisper(dist(PC_scores), group = data_combined$Chirality)
set.seed(42)
permutest(bd_chirality, permutations = 9999)

tapply(
  bd_chirality$distances,
  bd_chirality$group,
  mean
)

plot(bd_chirality)

```
